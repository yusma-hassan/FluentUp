# ──────────────────────────────────────────────────────────────────────────────
# FluentUp MVP-0 — Environment Variables
#
# Copy this file to .env.local for local development (never commit .env.local).
# On Vercel: add each variable below via Project Settings → Environment Variables.
# All variables here are SERVER-SIDE ONLY — none use the NEXT_PUBLIC_ prefix,
# so they are never included in the client-side JavaScript bundle.
# ──────────────────────────────────────────────────────────────────────────────

# AI Provider — currently only 'gemini' is supported in MVP-0
AI_PROVIDER=gemini

# API key for the Gemini API (Google AI Studio or Google Cloud)
# Vercel: add as a secret environment variable (all environments)
AI_API_KEY=your_api_key_here

# Gemini model identifier
# Vercel: add as a plain environment variable (all environments)
AI_MODEL=gemini-3.6-flash

# Optional: request timeout in milliseconds (default: 30000)
# Vercel: add as a plain environment variable if you need a non-default value
AI_TIMEOUT_MS=30000
